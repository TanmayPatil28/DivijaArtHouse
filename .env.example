# ==============================================================================
# DivijaArtHouse Environment Variables Template
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (MySQL via Prisma ORM)
# ------------------------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/divijaarthouse"

# ------------------------------------------------------------------------------
# 2. Authentication (NextAuth.js v5 / Auth.js)
# ------------------------------------------------------------------------------
# Secret used to encrypt session cookies and JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="divijaarthouse-development-secret-key-32charsmin"
AUTH_SECRET="divijaarthouse-development-secret-key-32charsmin"

# Canonical URL of the application
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 (Optional in dev; required for "Sign in with Google")
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. Razorpay Payment Gateway Toggle & API Keys
# ------------------------------------------------------------------------------
# Toggle to "true" to activate Razorpay checkout modal; set to "false" for Cash on Delivery (COD) mode.
NEXT_PUBLIC_RAZORPAY_ENABLED="false"

# Razorpay Test / Live Key Pair (obtain from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ------------------------------------------------------------------------------
# 5. Nodemailer Transactional Email (Gmail App Password or Standard SMTP)
# ------------------------------------------------------------------------------
# If left empty in development, Nodemailer will log formatted email previews
# to the server console without throwing errors (safe simulated mode).
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""

# From header displayed in recipient email inboxes
EMAIL_FROM="DivijaArtHouse <orders@divijaarthouse.com>"

# Administrator inbox that receives new order notifications
ADMIN_EMAIL="admin@divijaarthouse.com"

# SMTP Alias fallbacks (also supported)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DivijaArtHouse <orders@divijaarthouse.com>"
